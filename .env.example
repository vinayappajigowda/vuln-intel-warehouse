# Free key: https://nvd.nist.gov/developers/request-an-api-key
# Without it you are limited to 5 requests / 30 s (a full NVD load takes ~25 min instead of ~5 min).
# Paste the key with no quotes and no spaces, e.g. NVD_API_KEY=1a2b3c4d-....
NVD_API_KEY=

# Where raw files land. Relative paths are relative to the project folder.
VULNINTEL_DATA_DIR=data

# duckdb (local, free) or bigquery
VULNINTEL_WAREHOUSE=duckdb
# Defaults to <data dir>/warehouse.duckdb. Only set this to put the database somewhere else.
# VULNINTEL_DUCKDB_PATH=

# EPSS history to backfill on first run (days). 365 is ~110M rows: fine for BigQuery, slow-ish on a laptop.
VULNINTEL_EPSS_BACKFILL_DAYS=90

# Only needed when VULNINTEL_WAREHOUSE=bigquery
GCP_PROJECT=
BQ_RAW_DATASET=vulnintel_raw
BQ_LOCATION=US

# DuckDB guard rails for dbt (laptop-friendly). 2GB is the minimum for a full NVD + 90 days of EPSS.
# A runaway query fails at DUCKDB_MAX_TEMP instead of filling your disk.
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_MAX_TEMP=20GiB
